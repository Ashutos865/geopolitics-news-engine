        "title": "The 5 Qualities of Site-Specific AI Chatbots",
        "link": "https://www.nngroup.com/articles/dimensions-of-ai-chatbots/?utm_source=rss&utm_medium=feed&utm_campaign=rss-syndication",
        "source": "NN/g latest articles and announcements",
