    {
        "title": "NVIDIA Alpamayo 2 Super, the Frontier Open Model for Robotaxis and Autonomous Vehicles, Now Available for Commercial Use",
        "link": "https://blogs.nvidia.com/blog/alpamayo-2-super-open-model-now-available/",
        "source": "NVIDIA Blog",
<<<<<<< Updated upstream
        "timestamp": "2026-08-18T23:58:47.415582+00:00",
=======
        "timestamp": "2026-08-19T00:00:28.647354+00:00",
