    {
        "title": "Slack vs. Zoom: Which Is Best for Collaboration?",
        "link": "https://slack.com/blog/compare/slack-vs-zoom",
        "source": "Slack Blog",
<<<<<<< Updated upstream
        "timestamp": "2026-08-21T20:40:18.246593+00:00",
