    {
        "title": "'They knew': US states accuse Meta of hiding Instagram's impact on teenagers",
        "link": "https://timesofindia.indiatimes.com/world/us/they-knew-us-states-accuse-meta-of-hiding-instagrams-impact-on-teenagers/articleshow/133334390.cms",
        "source": "Times of India",
        "timestamp": "2026-08-19T00:00:28.649930+00:00",
