    {
        "title": "The Attacker Never Sleeps, Neither Can Your Testing",
        "link": "https://snyk.io/blog/attacker-never-sleeps-neither-can-testing/",
        "source": "Blog RSS Feed | Snyk",
<<<<<<< Updated upstream
        "timestamp": "2026-08-18T23:58:47.415961+00:00",
=======
        "timestamp": "2026-08-19T00:00:28.647741+00:00",
