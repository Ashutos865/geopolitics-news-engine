        "title": "Secure all your internal vibe-coded applications — in one click",
        "link": "https://blog.cloudflare.com/workers-protected-by-access/",
        "source": "Cloudflare Blog",
<<<<<<< Updated upstream
        "timestamp": "2026-08-21T20:40:18.245400+00:00",
=======
        "timestamp": "2026-08-21T20:51:27.470540+00:00",
