        "title": "Building a Custom Metrics Exporter for Kubernetes",
        "link": "https://kubernetes.io/blog/2026/07/14/custom-metrics-exporter-kubernetes/",
        "source": "Kubernetes Blog",
        "timestamp": "2026-08-21T22:20:57.839406+00:00",
