    {
        "title": "From all-or-nothing to task-based OAuth consent",
        "link": "https://blog.cloudflare.com/task-based-oauth-consent/",
        "source": "Cloudflare Blog",
<<<<<<< Updated upstream
        "timestamp": "2026-08-21T20:40:18.245385+00:00",
=======
        "timestamp": "2026-08-21T20:51:27.470519+00:00",
