    {
        "title": "Enabling the next iteration of the borrow checker on nightly",
        "link": "https://blog.rust-lang.org/2026/08/04/enabling-polonius-alpha-on-nightly/",
        "source": "Rust Blog",
<<<<<<< Updated upstream
        "timestamp": "2026-08-21T20:40:18.246523+00:00",
