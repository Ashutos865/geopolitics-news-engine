        "title": "Searchable field-level encryption on Supabase with CipherStash",
        "link": "https://supabase.com/blog/searchable-field-level-encryption-with-cipherstash",
        "source": "Supabase Blog",
<<<<<<< Updated upstream
        "timestamp": "2026-08-18T23:58:47.416048+00:00",
