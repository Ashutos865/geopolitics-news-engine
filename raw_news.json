        "title": "How Cloudflare detects MCP traffic and helps secure it",
        "link": "https://blog.cloudflare.com/mcp-security-updates/",
        "source": "Cloudflare Blog",
<<<<<<< Updated upstream
        "timestamp": "2026-08-18T23:58:47.419083+00:00",
