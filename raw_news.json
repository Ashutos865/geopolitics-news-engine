        "title": "Putting sign language AI into users’ hands",
        "link": "https://deepmind.google/blog/putting-sign-language-ai-into-users-hands/",
        "source": "Google DeepMind News",
<<<<<<< Updated upstream
        "timestamp": "2026-08-21T20:40:18.245532+00:00",
