    {
        "title": "Terraform Your Fastly Config in a few Commands",
        "link": "https://www.fastly.com/blog/terraform-your-fastly-config-in-a-few-commands/",
        "source": "Fastly Blog",
<<<<<<< Updated upstream
        "timestamp": "2026-08-18T23:58:47.414887+00:00",
