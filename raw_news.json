    {
        "title": "Why India's medical devices manufacturing has seen limited success",
        "link": "https://www.businesstoday.in/magazine/deep-dive/story/why-indias-medical-devices-manufacturing-has-seen-limited-success-549744-2026-08-18?utm_source=rssfeed",
        "source": "Business News India: Latest Business News Today, Share Market, Economy",
<<<<<<< Updated upstream
        "timestamp": "2026-08-18T23:58:47.413866+00:00",
