        "title": "Animating CSS border-image",
        "link": "https://css-tricks.com/animating-css-border-image/",
        "source": "CSS-Tricks",
<<<<<<< Updated upstream
        "timestamp": "2026-08-18T23:58:47.416707+00:00",
