        "link": "https://www.bhutantoday.bt/%f0%9d%90%81%f0%9d%90%a1%f0%9d%90%ae%f0%9d%90%ad%f0%9d%90%9a%f0%9d%90%a7-%f0%9d%90%92%f0%9d%90%ae%f0%9d%90%9b%f0%9d%90%a6%f0%9d%90%a2%f0%9d%90%ad%f0%9d%90%ac-%f0%9d%90%85%f0%9d%90%a2%f0%9d%90%ab/",
        "source": "BHUTAN TODAY",
