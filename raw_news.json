        "link": "https://www.eurogamer.net/fallout-4-creations-update-mods-breaking",
        "source": "Eurogamer.net Latest Articles Feed",
<<<<<<< Updated upstream
        "timestamp": "2026-08-18T19:44:08.469580+00:00",
=======
        "timestamp": "2026-08-18T20:19:42.484534+00:00",
