        "title": "Certificate Transparency Monitoring is now generally available",
        "link": "https://blog.cloudflare.com/certificate-transparency-monitoring-ga/",
        "source": "Cloudflare Blog",
<<<<<<< Updated upstream
        "timestamp": "2026-08-21T20:40:18.245407+00:00",
