    {
        "title": "Sponsor Success at Apache: Google and Apache Iceberg",
        "link": "https://news.apache.org/foundation/entry/sponsor-success-at-apache-google-and-apache-iceberg",
        "source": "The ASF Blog",
<<<<<<< Updated upstream
        "timestamp": "2026-08-18T23:58:47.414449+00:00",
=======
        "timestamp": "2026-08-19T00:00:28.646162+00:00",
