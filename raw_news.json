    {
        "title": "Give any website a WebMCP interface",
        "link": "https://blog.cloudflare.com/webmcp/",
        "source": "Cloudflare Blog",
<<<<<<< Updated upstream
        "timestamp": "2026-08-13T20:07:01.360939+00:00",
=======
