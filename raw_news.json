    {
        "title": "Once Upon a Time in the Middle East: A new frame on anti-war films",
        "link": "https://news.cgtn.com/news/2026-08-13/Once-Upon-a-Time-in-the-Middle-East-A-new-frame-on-anti-war-films-1PzXyNPxF6w/p.html?UTM_Source=cgtn&UTM_Medium=rss&UTM_Campaign=China",
