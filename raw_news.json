        "title": "Grow Organizational Culture and Leadership at Work",
        "link": "https://slack.com/blog/transformation/organizational-culture-and-leadership",
        "source": "Slack Blog",
<<<<<<< Updated upstream
        "timestamp": "2026-08-18T23:58:47.415895+00:00",
=======
        "timestamp": "2026-08-19T00:00:28.647675+00:00",
