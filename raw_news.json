    {
        "title": "ODC-Noord: Building blocks for an existing government cloud",
        "link": "https://www.redhat.com/en/blog/odc-noord-building-blocks-existing-government-cloud",
        "source": "Red Hat Blog",
<<<<<<< Updated upstream
        "timestamp": "2026-08-18T23:58:47.415777+00:00",
