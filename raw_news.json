    {
        "title": "The next generation of MCP",
        "link": "https://blog.cloudflare.com/mcp-v2/",
        "source": "Cloudflare Blog",
<<<<<<< Updated upstream
        "timestamp": "2026-08-18T23:58:47.414732+00:00",
=======
        "timestamp": "2026-08-19T00:00:28.646436+00:00",
