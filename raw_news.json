    {
        "title": "How student athletes are changing the game",
        "link": "https://www.redhat.com/en/blog/how-student-athletes-are-changing-game",
        "source": "Red Hat Blog",
<<<<<<< Updated upstream
        "timestamp": "2026-08-18T23:58:47.415780+00:00",
=======
