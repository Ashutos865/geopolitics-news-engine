        "title": "Design-System Maturity: A 6-Dimension Framework",
        "link": "https://www.nngroup.com/articles/design-system-maturity/?utm_source=rss&utm_medium=feed&utm_campaign=rss-syndication",
        "source": "NN/g latest articles and announcements",
