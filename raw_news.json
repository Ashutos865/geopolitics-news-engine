        "title": "Spotlight on WG Device Management",
        "link": "https://kubernetes.io/blog/2026/06/24/wg-device-management-spotlight-2026/",
        "source": "Kubernetes Blog",
        "timestamp": "2026-08-21T20:40:18.245989+00:00",
