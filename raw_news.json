    {
        "title": "Exa joins the Vercel Agent Marketplace",
        "link": "https://vercel.com/changelog/exa-joins-the-vercel-agent-marketplace",
        "source": "Vercel News",
        "timestamp": "2026-08-13T20:07:01.362463+00:00",
        "image": "https://assets.vercel.com/image/upload/contentful/image/e5382hct74si/tOxU4eJG1LvwIV6w2smwH/792b7beb69a189e7f6f1a054bac0d786/exa_joins_vercel_agent_marketplace_og_card.jpg",
        "full_content": "Exa is now available on the Vercel Agent Marketplace as a native integration.\nExa's neural search engine delivers high-quality, relevant results to ground AI in fresh, current information. Add Exa to your Vercel app in seconds to power search, research agents, and context-aware features. The Vercel integration provides a single API key that works across all Exa products, with billing handled directly through your Vercel account.\nimport Exa from \"exa-js\";import { NextResponse } from \"next/server\";const apiKey = process.env.EXA_API_KEY;if (!apiKey) {  throw new Error(\"Missing EXA_API_KEY\");}const exa = new Exa(apiKey);export async function GET(request: Request) {  const { searchParams } = new URL(request.url);  const query = searchParams.get(\"q\") ?? \"latest AI infrastructure news\";  const { results } = await exa.search(query, {    type: \"instant\",    numResults: 5,    contents: {      highlights: true,    },  });  return NextResponse.json({    results: results.map((result) => ({      title: result.title,      url: result.url,      highlights: result.highlights,    })),  });}\nExecute your first API call in minutes\nInstall Exa from the Marketplace or deploy the Next.js Search template to see Exa's instant search, deep answers, and contents extraction integrated with Vercel.\nAbout Exa: For developers building AI features on Vercel, Exa gives agents the web, organized for them. Whether you're answering questions, monitoring changes, or extracting structured data, Exa's one API for search, crawling, and research returns token-efficient highlights with grounded citations, so your agents get the context they need with fewer round trips, lower cost, and lower latency.",
        "content": "Exa is now available on the Vercel Agent Marketplace as a native integration.\nExa's neural search engine delivers high-quality, relevant results to ground AI in fresh, current information. Add Exa to your Vercel app in seconds to power search, research agents, and context-aware features. The Vercel integration provides a single API key that works across all Exa products, with billing handled direc...",
