        "title": "Amazon Quick for Microsoft 365: Agentic AI where you work",
        "link": "https://aws.amazon.com/blogs/machine-learning/amazon-quick-for-microsoft-365-agentic-ai-where-you-work/",
        "source": "Artificial Intelligence",
