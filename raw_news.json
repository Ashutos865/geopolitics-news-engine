        "title": "5 new ways to level up your learning with Search",
        "link": "https://blog.google/products-and-platforms/products/search/back-to-school-study-tools/",
        "source": "AI",
<<<<<<< Updated upstream
        "timestamp": "2026-08-21T20:40:18.245784+00:00",
