    {
        "title": "Bring your spreadsheet data to life with Sheets canvas",
        "link": "https://blog.google/products-and-platforms/products/workspace/sheets-canvas-for-google-sheets-spreadsheets/",
        "source": "AI",
<<<<<<< Updated upstream
        "timestamp": "2026-08-18T19:44:08.467497+00:00",
