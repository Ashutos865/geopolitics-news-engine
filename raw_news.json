    {
        "title": "Inside the Vercel intern experience",
        "link": "https://vercel.com/blog/inside-the-vercel-intern-experience",
        "source": "Vercel News",
<<<<<<< Updated upstream
        "timestamp": "2026-08-18T19:44:08.469037+00:00",
