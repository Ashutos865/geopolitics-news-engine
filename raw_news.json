        "title": "GitLab Secrets Manager adds ESO, Terraform, API support",
        "link": "https://about.gitlab.com/blog/gitlab-secrets-manager-add-eso-terraform-api-support/",
        "source": "GitLab",
<<<<<<< Updated upstream
        "timestamp": "2026-08-18T23:58:47.415007+00:00",
