        "link": "https://www.twilio.com/en-us/blog/developers/tutorials/integrations/phone-number-intelligence-tool-lookup-replit",
        "source": "Twilio Blog",
<<<<<<< Updated upstream
        "timestamp": "2026-08-18T23:58:47.416480+00:00",
