        "title": "Open Weights and the 2nd World",
        "link": "https://www.netlify.com/blog/open-weights-and-the-2nd-world",
        "source": "Netlify Blog",
<<<<<<< Updated upstream
        "timestamp": "2026-08-18T19:44:08.467889+00:00",
=======
        "timestamp": "2026-08-18T20:19:42.482866+00:00",
