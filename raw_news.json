    {
        "title": "A Concrete Definition of “Product Sense” (and How to Build It)",
        "link": "https://www.nngroup.com/articles/product-sense-definition/?utm_source=rss&utm_medium=feed&utm_campaign=rss-syndication",
        "source": "NN/g latest articles and announcements",
