    {
        "title": "When your backlog outgrows your team, GitLab scales remediation",
        "link": "https://about.gitlab.com/blog/gitlab-scales-remediation/",
        "source": "GitLab",
<<<<<<< Updated upstream
        "timestamp": "2026-08-21T20:40:18.245685+00:00",
