        "title": "Our approach to bioresilience",
        "link": "https://deepmind.google/blog/our-approach-to-bioresilience/",
        "source": "Google DeepMind News",
<<<<<<< Updated upstream
        "timestamp": "2026-08-18T23:58:47.414859+00:00",
