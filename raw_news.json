    {
        "title": "From fragmented to flawless: Unifying the AI development lifecycle",
        "link": "https://www.redhat.com/en/blog/fragmented-flawless-unifying-ai-development-lifecycle",
        "source": "Red Hat Blog",
<<<<<<< Updated upstream
        "timestamp": "2026-08-21T20:40:18.246479+00:00",
