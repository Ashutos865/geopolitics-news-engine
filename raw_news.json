        "title": "How Slack Rebuilt Notifications 📣",
        "link": "https://slack.engineering/how-slack-rebuilt-notifications/",
        "source": "Engineering at Slack",
<<<<<<< Updated upstream
        "timestamp": "2026-08-18T23:58:47.418621+00:00",
