    {
        "title": "GPU view-adaptive crack-free subdivision of Bézier surfaces",
        "link": "https://gpuopen.com/learn/gpu-view-adaptive-subdivision/",
        "source": "AMD GPUOpen",
<<<<<<< Updated upstream
        "timestamp": "2026-08-21T20:40:18.245126+00:00",
