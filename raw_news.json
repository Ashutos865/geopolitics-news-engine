    {
        "title": "NVIDIA and Local AI Community Fuel Open Source Models and Intelligent Agents",
        "link": "https://blogs.nvidia.com/blog/local-ai-open-source-models-agents-nemotron/",
        "source": "NVIDIA Blog",
<<<<<<< Updated upstream
        "timestamp": "2026-08-18T23:58:47.415558+00:00",
=======
        "timestamp": "2026-08-19T00:00:28.647329+00:00",
