    {
        "title": "NVIDIA Nemotron 3.5 Lightning and NeMo Switchyard Deliver Faster, Smarter, More Efficient Agentic AI",
        "link": "https://blogs.nvidia.com/blog/nemotron-lightning-switchyard-rtx-dgx/",
        "source": "NVIDIA Blog",
<<<<<<< Updated upstream
        "timestamp": "2026-08-18T23:58:47.415561+00:00",
