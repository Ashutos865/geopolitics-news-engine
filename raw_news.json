        "title": "Four travel and hospitality trends from HITEC 2026",
        "link": "https://stripe.com/blog/trends-from-hitec",
        "source": "Stripe Blog",
<<<<<<< Updated upstream
        "timestamp": "2026-08-21T20:40:18.246725+00:00",
