    {
        "title": "Nigeria: Is the Trump-Tinubu Collaboration Working?",
        "link": "https://allafrica.com/stories/202608180566.html",
        "source": "AllAfrica News: Latest",
<<<<<<< Updated upstream
        "timestamp": "2026-08-18T23:58:47.417280+00:00",
=======
        "timestamp": "2026-08-19T00:00:28.649332+00:00",
