        "title": "The Importance of Emotional Intelligence in Leadership",
        "link": "https://slack.com/blog/collaboration/emotional-intelligence-in-leadership",
        "source": "Slack Blog",
<<<<<<< Updated upstream
        "timestamp": "2026-08-18T23:58:47.415899+00:00",
