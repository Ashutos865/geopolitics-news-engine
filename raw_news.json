    {
        "title": "Guide: Best Final Fantasy Games, Ranked - Switch 2 And Nintendo Systems",
        "link": "https://www.nintendolife.com/guides/best-final-fantasy-games-ranked-switch-2-and-nintendo-systems",
        "source": "Nintendo Life | Latest Updates",
