    {
        "title": "Delivering A Resilient World Cup Final",
        "link": "https://www.fastly.com/blog/delivering-a-resilient-world-cup-final/",
        "source": "Fastly Blog",
<<<<<<< Updated upstream
        "timestamp": "2026-08-18T23:58:47.414918+00:00",
