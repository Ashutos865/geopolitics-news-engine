    {
        "title": "NVIDIA AI Factory Compute Is Becoming an Investable Asset Class",
        "link": "https://blogs.nvidia.com/blog/nvidia-ai-factory-compute/",
        "source": "NVIDIA Blog",
<<<<<<< Updated upstream
        "timestamp": "2026-08-21T20:40:18.246259+00:00",
