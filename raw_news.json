    {
        "title": "Post-mortem GPU crash debugging with LLMs",
        "link": "https://gpuopen.com/learn/post-mortem-gpu-crash-debugging-with-llms/",
        "source": "AMD GPUOpen",
<<<<<<< Updated upstream
        "timestamp": "2026-08-21T20:40:18.245133+00:00",
=======
        "timestamp": "2026-08-21T20:51:27.470226+00:00",
