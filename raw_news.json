        "title": "Job Opening: People & Culture Generalist (Remote, US Based)",
        "link": "https://www.nngroup.com/news/item/people-culture-generalist-remote/?utm_source=rss&utm_medium=feed&utm_campaign=rss-syndication",
        "source": "NN/g latest articles and announcements",
        "timestamp": "2026-08-21T21:05:23.146574+00:00",
