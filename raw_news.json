        "title": "Introducing Supabase Evals",
        "link": "https://supabase.com/blog/introducing-supabase-evals",
        "source": "Supabase Blog",
<<<<<<< Updated upstream
        "timestamp": "2026-08-18T23:58:47.416029+00:00",
