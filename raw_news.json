        "title": "Employee Retention Strategies to Reduce Turnover",
        "link": "https://slack.com/blog/collaboration/employee-retention",
        "source": "Slack Blog",
<<<<<<< Updated upstream
        "timestamp": "2026-08-21T20:40:18.246621+00:00",
=======
        "timestamp": "2026-08-21T20:51:27.471747+00:00",
