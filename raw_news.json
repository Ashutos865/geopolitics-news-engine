    {
        "title": "MCP goes stateless and extensible",
        "link": "https://www.netlify.com/blog/mcp-goes-stateless-and-extensible",
        "source": "Netlify Blog",
<<<<<<< Updated upstream
        "timestamp": "2026-08-18T19:44:08.467892+00:00",
=======
        "timestamp": "2026-08-18T20:19:42.482869+00:00",
