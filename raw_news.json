    {
        "title": "The Google AI Deal No Publisher Wanted Just Handed Them Something Better: Clarity",
        "link": "https://www.fastly.com/blog/google-ai-deal-no-publisher-wanted/",
        "source": "Fastly Blog",
<<<<<<< Updated upstream
        "timestamp": "2026-08-18T23:58:47.414915+00:00",
